<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/context_bar_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#D40000"
    android:visibility="gone">

    <!-- Main Bar Row -->
    <LinearLayout
        android:id="@+id/context_bar_main_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Text Content Container -->
        <LinearLayout
            android:id="@+id/context_bar_text_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Line 1: Use {targetWord} — you used {matchedClue} or Telugu translation -->
            <TextView
                android:id="@+id/context_bar_line1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp" />

            <!-- Line 2: why_explanation -->
            <TextView
                android:id="@+id/context_bar_line2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Down Arrow Icon -->
        <ImageView
            android:id="@+id/context_bar_arrow"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_drop_down"
            android:contentDescription="Expand panel"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

    <!-- Expanded Dropdown Panel -->
    <LinearLayout
        android:id="@+id/context_bar_dropdown_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#B80000"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E57373"
            android:layout_marginBottom="6dp" />

        <!-- Row 1: Read aloud -->
        <TextView
            android:id="@+id/context_bar_btn_read_aloud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Read aloud"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Row 2: Translate -->
        <TextView
            android:id="@+id/context_bar_btn_translate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Translate"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

    </LinearLayout>

</LinearLayout>
